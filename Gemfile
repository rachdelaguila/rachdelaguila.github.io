source "https://rubygems.org"

# Use the github-pages gem so local builds match GitHub Pages' legacy Jekyll
# build environment (this site is built by GitHub Pages from `master`).
gem "github-pages", group: :jekyll_plugins

# Jekyll's built-in server needs webrick, which is no longer bundled with
# Ruby 3.0+ and must be requested explicitly for `jekyll serve` to work.
gem "webrick", "~> 1.8"
